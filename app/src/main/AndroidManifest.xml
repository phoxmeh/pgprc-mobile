<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bluetooth SPP (Mobilinkd/TNC3-style KISS TNCs). Legacy permissions for
         pre-Android-12; BLUETOOTH_CONNECT/SCAN are the runtime-requested ones
         on API 31+. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- USB-serial KISS TNC over OTG and USB Audio/PTT (Digirig and similar). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- AudioRecord requires RECORD_AUDIO even when routing to a USB audio device. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Forces the USB output device's STREAM_MUSIC volume to max on connect, so TX level
         doesn't depend on the phone's media slider. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Desktop-notification-equivalent (directed-frame / incoming-connection alerts). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keeps live port connections and scheduled beacons running while backgrounded.
         dataSync fits the network transports (AGWPE/KISS-TCP/Telnet/SSH) built so far.
         connectedDevice needs a runtime-*granted* Bluetooth/USB permission at the moment
         startForeground() is called, not just a manifest declaration — add it back
         alongside dataSync (and request BLUETOOTH_CONNECT first) once the Bluetooth/
         USB-serial transports land (tasks #89/#90), rather than declaring it prematurely. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Required for the RECORD_AUDIO app-op to actually deliver captured samples while the
         AFSK modem's AudioRecord runs inside the background service — without this, Android's
         AudioPolicyService silently zeroes the input ("App op 27 missing, silencing record"),
         even though the RECORD_AUDIO permission itself shows granted. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:name=".PacketRadioApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PgprcMobile"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PgprcMobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.PacketRadioService"
            android:foregroundServiceType="dataSync|connectedDevice|microphone"
            android:exported="false" />

    </application>

</manifest>
